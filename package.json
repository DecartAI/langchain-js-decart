{
	"name": "@decartai/langchain",
	"version": "0.1.1",
	"description": "LangChain.js integration for Decart AI - Image, Video, and Realtime Video Generation",
	"author": "Decart AI",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"test:unit": "jest tests/unit",
		"test:integration": "jest tests/integration",
		"lint": "eslint src/",
		"clean": "rm -rf dist/",
		"prepublishOnly": "npm run build",
		"release": "bumpp"
	},
	"dependencies": {
		"zod": "^3.22.0"
	},
	"peerDependencies": {
		"@langchain/core": ">=0.3.0 <2.0.0"
	},
	"devDependencies": {
		"@langchain/anthropic": "^1.3.2",
		"@langchain/classic": "^1.0.7",
		"@langchain/core": "^1.1.7",
		"@types/jest": "^29.5.0",
		"@types/node": "^20.0.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"bumpp": "^10.3.2",
		"eslint": "^8.0.0",
		"jest": "^29.7.0",
		"langchain": "^1.2.2",
		"ts-jest": "^29.1.0",
		"tsup": "^8.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.3.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"langchain",
		"decart",
		"ai",
		"image-generation",
		"video-generation",
		"realtime",
		"webrtc",
		"machine-learning",
		"generative-ai"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/DecartAI/langchain-js-decart"
	},
 	"bugs": {
 		"url": "https://github.com/DecartAI/langchain-js-decart/issues"
 	},
 	"homepage": "https://github.com/DecartAI/langchain-js-decart#readme"
}
